@@ -0,0 +1,123 @@
+package com.phonebridge
+
+// PhoneBridge NG, 2026-09-19. SPDX-License-Identifier: GPL-3.0-or-later
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.os.ParcelFileDescriptor
+import android.text.Editable
+import android.text.TextWatcher
+import android.util.TypedValue
+import android.view.ContextThemeWrapper
+import android.widget.TextView
+import androidx.lifecycle.Lifecycle
+import androidx.test.core.app.ActivityScenario
+import androidx.test.platform.app.InstrumentationRegistry
+import com.phonebridge.service.PhoneBridgeService
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import java.util.concurrent.atomic.AtomicInteger
+
+class CompatibilityTest {
+    private val instrumentation = InstrumentationRegistry.getInstrumentation()
+    private val context: Context get() = instrumentation.targetContext
+
+    @Before fun stopSharingBeforeCase() { context.stopService(Intent(context, PhoneBridgeService::class.java)) }
+    @After fun stopSharingAfterCase() { context.stopService(Intent(context, PhoneBridgeService::class.java)) }
+
+    @Test fun themeInflatesWithInheritedColorsOnThisApi() {
+        val themed = ContextThemeWrapper(context, R.style.Theme_PhoneBridge)
+        val colors = themed.obtainStyledAttributes(intArrayOf(
+            android.R.attr.statusBarColor, android.R.attr.navigationBarColor,
+            androidx.appcompat.R.attr.colorPrimary, android.R.attr.windowLightStatusBar))
+        try {
+            assertEquals(context.getColor(R.color.bg_primary), colors.getColor(0, 0))
+            assertEquals(context.getColor(R.color.bg_primary), colors.getColor(1, 0))
+            assertEquals(context.getColor(R.color.accent), colors.getColor(2, 0))
+            assertTrue(colors.getBoolean(3, false))
+        } finally { colors.recycle() }
+        if (Build.VERSION.SDK_INT >= 27) {
+            val value = TypedValue()
+            assertTrue(themed.theme.resolveAttribute(android.R.attr.windowLightNavigationBar, value, true))
+            assertEquals(TypedValue.TYPE_INT_BOOLEAN, value.type)
+            assertTrue(value.data != 0)
+        }
+    }
+
+    private fun status(running: Boolean) {
+        context.sendBroadcast(Intent(PhoneBridgeService.BROADCAST_STATUS).setPackage(context.packageName)
+            .putExtra(PhoneBridgeService.EXTRA_IS_RUNNING, running))
+    }
+    private fun text(view: TextView): String {
+        var result = ""
+        instrumentation.runOnMainSync { result = view.text.toString() }
+        return result
+    }
+    private fun awaitText(view: TextView, expected: String) {
+        val deadline = System.nanoTime() + 3_000_000_000L
+        while (System.nanoTime() < deadline) {
+            if (text(view) == expected) return
+            Thread.sleep(25)
+        }
+        assertEquals(expected, text(view))
+    }
+
+    @Test fun ownStatusWorksAfterPauseResumeAndRecreation() {
+        ActivityScenario.launch(MainActivity::class.java).use { scenario ->
+            lateinit var view: TextView
+            scenario.onActivity { view = it.findViewById(R.id.tvStatus) }
+            awaitText(view, "Tap to start")
+            repeat(3) {
+                status(true)
+                awaitText(view, "Running")
+                status(false)
+                awaitText(view, "Tap to start")
+                scenario.moveToState(Lifecycle.State.CREATED)
+                status(true)
+                instrumentation.waitForIdleSync()
+                Thread.sleep(100)
+                assertEquals("Tap to start", text(view))
+                scenario.moveToState(Lifecycle.State.RESUMED)
+                awaitText(view, "Tap to start")
+                scenario.recreate()
+                scenario.onActivity { view = it.findViewById(R.id.tvStatus) }
+                awaitText(view, "Tap to start")
+            }
+        }
+    }
+
+    @Test fun externalShellCannotSpoofAppStatus() {
+        ActivityScenario.launch(MainActivity::class.java).use { scenario ->
+            lateinit var view: TextView
+            val spoofedUpdates = AtomicInteger(0)
+            scenario.onActivity {
+                view = it.findViewById(R.id.tvStatus)
+                view.addTextChangedListener(object : TextWatcher {
+                    override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
+                    override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {
+                        if (s.toString() == "Running") spoofedUpdates.incrementAndGet()
+                    }
+                    override fun afterTextChanged(s: Editable?) {}
+                })
+            }
+            awaitText(view, "Tap to start")
+            // Shell has a different UID; no adoptShellPermissionIdentity and no exported test hook.
+            val output = instrumentation.uiAutomation.executeShellCommand(
+                "am broadcast -a com.phonebridge.broadcast.STATUS -p com.phonebridge --ez is_running true")
+            val shellResult = ParcelFileDescriptor.AutoCloseInputStream(output).use { it.readBytes().toString(Charsets.UTF_8) }
+            assertTrue("The external broadcast command must execute", shellResult.contains("Broadcast completed:"))
+            instrumentation.waitForIdleSync()
+            Thread.sleep(250)
+            assertEquals(0, spoofedUpdates.get())
+            assertEquals("Tap to start", text(view))
+            // Positive control: the same payload from this app must still be delivered.
+            status(true)
+            awaitText(view, "Running")
+            assertTrue(spoofedUpdates.get() > 0)
+            status(false)
+            awaitText(view, "Tap to start")
+        }
+    }
+}
