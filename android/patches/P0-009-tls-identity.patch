@@ -0,0 +1,52 @@
+package com.phonebridge
+
+// PhoneBridge NG, 2026-09-19. SPDX-License-Identifier: GPL-3.0-or-later
+import android.app.ActivityManager
+import android.content.Context
+import android.content.Intent
+import androidx.test.core.app.ActivityScenario
+import androidx.test.platform.app.InstrumentationRegistry
+import com.phonebridge.service.PhoneBridgeService
+import java.io.File
+import org.junit.Assert.*
+import org.junit.Assume.assumeTrue
+import org.junit.Test
+
+/** Explicit integration host for the real service; emits no credentials or UI hierarchy. */
+class TlsServiceHost {
+    @Test fun hostAuthorizedExperiment() {
+        val args = InstrumentationRegistry.getArguments()
+        assumeTrue(args.getString("p0_tls_host") == "P0-009")
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        val manager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+        val ready = File(context.cacheDir, "p0-009-ready")
+        val stop = File(context.cacheDir, "p0-009-stop")
+        check(!stop.exists() && !ready.exists())
+        val intent = Intent(context, PhoneBridgeService::class.java).setAction(PhoneBridgeService.ACTION_START)
+        fun isRunning() = manager.getRunningServices(20).any {
+            it.service.className == PhoneBridgeService::class.java.name && it.foreground
+        }
+        try {
+            ActivityScenario.launch(MainActivity::class.java).use { scenario ->
+              try {
+                scenario.onActivity { it.startForegroundService(intent) }
+                // The sharing UI animates continuously; waiting for global UI idleness
+                // can stall a test even after the real service is already listening.
+                // This main-thread callback runs after synchronous TLS initialization.
+                android.os.Handler(android.os.Looper.getMainLooper()).postDelayed({
+                    ready.writeText(if (isRunning()) "running" else "rejected")
+                }, 1000)
+                val deadline = System.nanoTime() + 180_000_000_000L
+                while (!stop.exists() && System.nanoTime() < deadline) Thread.sleep(100)
+                assertTrue("Host control timed out", stop.exists())
+              } finally {
+                // Stop sharing/its pulse animation before ActivityScenario.close waits for idle.
+                context.stopService(intent)
+              }
+            }
+        } finally {
+            context.stopService(intent)
+            ready.delete(); stop.delete()
+        }
+    }
+}
