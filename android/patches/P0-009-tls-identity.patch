+package com.phonebridge.server
+
+// PhoneBridge NG, 2026-09-19. SPDX-License-Identifier: GPL-3.0-or-later
+import android.system.Os
+import androidx.test.platform.app.InstrumentationRegistry
+import org.junit.After
+import org.junit.Before
+import org.junit.Test
+import org.junit.Assert.*
+import java.io.*
+import java.nio.file.*
+import java.nio.file.attribute.BasicFileAttributes
+import java.util.UUID
+
+class SharedStorageTest {
+    private lateinit var area: File
+    private lateinit var root: File
+    private lateinit var outside: File
+    private lateinit var storage: SharedStorage
+    private fun path(name: String) = SharedPath.parse("/$name")
+    private fun put(name: String, text: String) = storage.put(path(name), text.byteInputStream(), text.toByteArray().size.toLong())
+    private fun read(name: String) = storage.read(path(name)).use { it.readBytes().decodeToString() }
+    private fun rejected(block: () -> Unit) {
+        try { block(); fail("Expected rejection") } catch (_: IOException) { } catch (_: android.system.ErrnoException) { }
+    }
+
+    @Before fun setup() {
+        area = File(InstrumentationRegistry.getInstrumentation().targetContext.cacheDir, "p0-005-" + UUID.randomUUID())
+        root = File(area, "share").apply { mkdirs() }
+        outside = File(area, "outside").apply { mkdir() }
+        File(outside, "sentinel").writeText("outside unchanged")
+        storage = SharedStorage(root)
+    }
+    @After fun cleanup() {
+        storage.close()
+        // Only this test's UUID private-cache tree. walkFileTree does not follow symbolic links.
+        Files.walkFileTree(area.toPath(), object : SimpleFileVisitor<Path>() {
+            override fun visitFile(file: Path, attrs: BasicFileAttributes): FileVisitResult {
+                Files.delete(file); return FileVisitResult.CONTINUE
+            }
+            override fun postVisitDirectory(dir: Path, exc: IOException?): FileVisitResult {
+                Files.delete(dir); return FileVisitResult.CONTINUE
+            }
+        })
+    }
+
+    @Test fun exactLengthAndAtomicOverwrite() {
+        assertTrue(put("file", "old"))
+        val body = "newNEXT".byteInputStream()
+        assertFalse(storage.put(path("file"), body, 3))
+        assertEquals("new", read("file"))
+        assertEquals("NEXT", body.readBytes().decodeToString())
+        assertFalse(storage.put(path("file"), ByteArrayInputStream(byteArrayOf()), 0))
+        assertEquals("", read("file"))
+    }
+    @Test fun shortAndFailingBodyPreserveOriginal() {
+        put("file", "old")
+        rejected { storage.put(path("file"), "bad".byteInputStream(), 20) }
+        assertEquals("old", read("file"))
+        rejected { storage.put(path("new"), "bad".byteInputStream(), 20) }
+        assertFalse(File(root, "new").exists())
+        val stalled = object : InputStream() { override fun read() = 0; override fun read(b: ByteArray, o: Int, n: Int) = 0 }
+        rejected { storage.put(path("file"), stalled, 20) }
+        assertEquals("old", read("file"))
+        assertEquals(listOf("file"), root.list()!!.toList())
+    }
+    @Test fun rootOperationsCannotDeleteSentinels() {
+        put("file", "old")
+        rejected { storage.delete(path("")) }
+        rejected { put("", "bad") }
+        rejected { storage.mkdir(path("")) }
+        rejected { storage.move(path("file"), path(""), true) }
+        rejected { storage.copy(path(""), path("new"), true) }
+        assertEquals("old", read("file"))
+    }
+    @Test fun ancestorAndFinalLinksNeverFollowed() {
+        Os.symlink(outside.path, File(root, "alias").path)
+        Os.symlink(File(outside, "sentinel").path, File(root, "link").path)
+        rejected { storage.read(path("alias/sentinel")) }
+        rejected { put("alias/sentinel", "bad") }
+        rejected { storage.mkdir(path("alias/created")) }
+        rejected { storage.delete(path("alias")) }
+        rejected { storage.delete(path("link")) }
+        rejected { storage.copy(path("link"), path("copy"), true) }
+        rejected { storage.move(path("alias"), path("moved"), true) }
+        assertTrue(storage.list(path("")).isEmpty())
+        assertEquals("outside unchanged", File(outside, "sentinel").readText())
+    }
+    @Test fun hardLinkedFilesAreRejected() {
+        try { Os.link(File(outside, "sentinel").path, File(root, "hardlink").path) }
+        catch (error: android.system.ErrnoException) {
+            if (error.errno != android.system.OsConstants.EACCES && error.errno != android.system.OsConstants.EPERM) throw error
+            org.junit.Assume.assumeTrue("Platform denied hard-link fixture creation; runtime guard unverified", false)
+        }
+        rejected { storage.read(path("hardlink")) }
+        rejected { put("hardlink", "bad") }
+        assertEquals("outside unchanged", File(outside, "sentinel").readText())
+    }
+    @Test fun parentSwappedDuringUploadStaysOnHeldDirectory() {
+        storage.mkdir(path("parent"))
+        put("parent/file", "old")
+        val body = object : ByteArrayInputStream("new".toByteArray()) {
+            override fun read(b: ByteArray, o: Int, n: Int): Int {
+                Os.rename(File(root, "parent").path, File(root, "held").path)
+                Os.symlink(outside.path, File(root, "parent").path)
+                return super.read(b, o, n)
+            }
+        }
+        storage.put(path("parent/file"), body, 3)
+        assertEquals("new", File(root, "held/file").readText())
+        assertFalse(File(outside, "file").exists())
+    }
+    @Test fun targetSwappedDuringUploadIsRejected() {
+        put("file", "old")
+        val body = object : ByteArrayInputStream("new".toByteArray()) {
+            override fun read(b: ByteArray, o: Int, n: Int): Int {
+                Os.remove(File(root, "file").path)
+                Os.symlink(File(outside, "sentinel").path, File(root, "file").path)
+                return super.read(b, o, n)
+            }
+        }
+        rejected { storage.put(path("file"), body, 3) }
+        assertEquals("outside unchanged", File(outside, "sentinel").readText())
+    }
+    @Test fun unknownReplacementOfTempIsRetained() {
+        put("file", "old")
+        val body = object : ByteArrayInputStream("new".toByteArray()) {
+            override fun read(b: ByteArray, o: Int, n: Int): Int {
+                val temp = root.listFiles()!!.single { it.name.startsWith(SharedPath.STAGING_PREFIX) }
+                Os.remove(temp.path)
+                Os.symlink(File(outside, "sentinel").path, temp.path)
+                return super.read(b, o, n)
+            }
+        }
+        rejected { storage.put(path("file"), body, 3) }
+        assertEquals("old", read("file"))
+        assertEquals(1, root.list()!!.count { it.startsWith(SharedPath.STAGING_PREFIX) })
+        assertEquals("outside unchanged", File(outside, "sentinel").readText())
+    }
+    @Test fun retainedStagingBlocksRecursiveDeleteAndMove() {
+        storage.mkdir(path("folder"))
+        val retained = File(root, "folder/${SharedPath.STAGING_PREFIX}retained.part").apply { writeText("retain") }
+        rejected { storage.delete(path("folder")) }
+        rejected { storage.move(path("folder"), path("elsewhere"), true) }
+        rejected { storage.copy(path("folder"), path("elsewhere"), true) }
+        assertTrue(storage.list(path("folder")).isEmpty())
+        assertEquals("retain", retained.readText())
+    }
+    @Test fun nestedCopyMoveDeleteAndOverwrite() {
+        storage.mkdir(path("dir"))
+        storage.mkdir(path("dir/sub"))
+        put("dir/sub/中文+%.txt", "content")
+        assertTrue(storage.copy(path("dir"), path("copy"), true))
+        assertEquals("content", read("copy/sub/中文+%.txt"))
+        assertTrue(storage.move(path("copy"), path("moved"), true))
+        put("target", "old")
+        rejected { storage.copy(path("dir/sub/中文+%.txt"), path("target"), false) }
+        assertEquals("old", read("target"))
+        assertFalse(storage.copy(path("dir/sub/中文+%.txt"), path("target"), true))
+        assertEquals("content", read("target"))
+        storage.delete(path("moved"))
+        assertFalse(File(root, "moved").exists())
+        assertEquals("content", read("dir/sub/中文+%.txt"))
+    }
+    @Test fun selectedRootCannotBeSymlink() {
+        val alias = File(area, "root-alias")
+        Os.symlink(outside.path, alias.path)
+        rejected { SharedStorage(alias).close() }
+    }
+    @Test fun openReadStreamSurvivesStorageClose() {
+        put("file", "old")
+        storage.read(path("file")).use { stream ->
+            storage.close()
+            assertEquals("old", stream.readBytes().decodeToString())
+        }
+    }
+}
