<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PhoneBridge.Desktop</AssemblyName>
    <RootNamespace>PhoneBridge.Desktop</RootNamespace>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>PhoneBridge NG</Product>
    <Company>PhoneBridge NG contributors</Company>
    <Description>Wireless access to Android files from Windows</Description>
    <ApplicationIcon>Assets\PhoneBridge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="PhoneBridge.Desktop.Tests" /></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\PhoneBridge.ico" />
    <Resource Include="Assets\PhoneBridge.png" />
    <EmbeddedResource Include="Assets\Tray\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PhoneBridge.Connection/PhoneBridge.Connection.csproj" />
    <ProjectReference Include="../PhoneBridge.Discovery.Windows/PhoneBridge.Discovery.Windows.csproj" />
  </ItemGroup>
</Project>
