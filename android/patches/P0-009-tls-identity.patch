index 0000000..4e785b6
--- /dev/null
+++ b/android/app/src/test/java/com/phonebridge/server/DeviceCertificatesTest.kt
@@ -0,0 +1,64 @@
+package com.phonebridge.server
+
+// PhoneBridge NG, 2026-09-19. SPDX-License-Identifier: GPL-3.0-or-later
+import java.net.InetAddress
+import java.security.KeyPairGenerator
+import java.security.cert.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class DeviceCertificatesTest {
+    private val key = KeyPairGenerator.getInstance("RSA").apply { initialize(2048) }.generateKeyPair()
+    private val server = KeyPairGenerator.getInstance("RSA").apply { initialize(2048) }.generateKeyPair()
+    private val ca = DeviceCertificates.authority(key.public, key.private)
+    private fun leaf(vararg ips: String) = DeviceCertificates.server(ca, key.private, server.public,
+        ips.map { InetAddress.getByName(it) }.toSet())
+    private fun validate(cert: X509Certificate, root: X509Certificate = ca) {
+        val path = CertificateFactory.getInstance("X.509").generateCertPath(listOf(cert))
+        val params = PKIXParameters(setOf(TrustAnchor(root, null))).apply { isRevocationEnabled = false }
+        CertPathValidator.getInstance("PKIX").validate(path, params)
+    }
+
+    @Test fun validChainHasRestrictedAuthorityAndServerUsage() {
+        val cert = leaf("127.0.0.1", "::1", "192.168.100.197")
+        validate(cert)
+        assertEquals(0, ca.basicConstraints)
+        assertTrue(ca.keyUsage[5])
+        assertEquals(-1, cert.basicConstraints)
+        assertFalse(cert.keyUsage[5])
+        assertEquals(listOf("1.3.6.1.5.5.7.3.1"), cert.extendedKeyUsage)
+        val ips = cert.subjectAlternativeNames.map { InetAddress.getByName(it[1] as String) }.toSet()
+        assertEquals(setOf("127.0.0.1", "::1", "192.168.100.197").map { InetAddress.getByName(it) }.toSet(), ips)
+        assertTrue(cert.subjectAlternativeNames.all { it[0] == 7 })
+        assertTrue(cert.notAfter.time - cert.notBefore.time <= 86_700_000L)
+    }
+
+    @Test fun addressRenewalRetainsTrustAnchorAndTlsKey() {
+        val before = leaf("192.168.1.2")
+        val after = leaf("192.168.1.3")
+        validate(before); validate(after)
+        assertNotEquals(before.serialNumber, after.serialNumber)
+        assertArrayEquals(before.publicKey.encoded, after.publicKey.encoded)
+        assertEquals(listOf(listOf(7, "192.168.1.3")), after.subjectAlternativeNames.toList())
+    }
+
+    @Test fun replacementIdentityIsRejected() {
+        val other = KeyPairGenerator.getInstance("RSA").apply { initialize(2048) }.generateKeyPair()
+        val wrong = DeviceCertificates.authority(other.public, other.private)
+        assertThrows(CertPathValidatorException::class.java) { validate(leaf("127.0.0.1"), wrong) }
+    }
+
+    @Test fun invalidAddressesCannotBeCertified() {
+        for (ip in listOf("0.0.0.0", "::", "224.0.0.1", "ff02::1")) {
+            assertThrows(IllegalArgumentException::class.java) { leaf(ip) }
+        }
+        assertThrows(IllegalArgumentException::class.java) { leaf() }
+    }
+
+    @Test fun expiredIdentityCannotIssueAddressCertificate() {
+        val expired = DeviceCertificates.authority(key.public, key.private, System.currentTimeMillis() - 3651L * 86_400_000)
+        assertThrows(CertificateExpiredException::class.java) {
+            DeviceCertificates.server(expired, key.private, server.public, setOf(InetAddress.getLoopbackAddress()))
+        }
+    }
+}
