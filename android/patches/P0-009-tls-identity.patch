+package com.phonebridge.server
+
+// PhoneBridge NG, 2026-09-19. SPDX-License-Identifier: GPL-3.0-or-later
+import androidx.test.platform.app.InstrumentationRegistry
+import java.io.File
+import java.net.InetAddress
+import java.security.KeyStore
+import java.security.SecureRandom
+import java.util.UUID
+import java.util.concurrent.atomic.AtomicInteger
+import javax.net.ssl.*
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Test
+
+/** Isolated key aliases and private cache fixtures; never changes the app's real identity. */
+class TlsIdentityTest {
+    private val context = InstrumentationRegistry.getInstrumentation().targetContext
+    private val prefix = "phonebridge.test.${UUID.randomUUID()}"
+    private val directory = File(context.cacheDir, prefix).apply { mkdirs() }
+    private val legacy = File(directory, "legacy.p12")
+    private val store = TlsIdentityStore(directory, prefix, legacy)
+    private val keyStore get() = KeyStore.getInstance("AndroidKeyStore").apply { load(null) }
+    private fun rejected(block: () -> Unit) {
+        try { block(); fail("Identity material must be rejected") } catch (_: Exception) { }
+    }
+    @After fun cleanup() {
+        val ks = keyStore
+        listOf("authority", "server").forEach { ks.deleteEntry("$prefix.$it") }
+        check(directory.parentFile == context.cacheDir && directory.name == prefix)
+        directory.deleteRecursively()
+    }
+
+    @Test fun identitySurvivesReloadAndBothKeysAreNonExportable() {
+        val first = store.open()
+        val second = store.open()
+        assertEquals(first.fingerprint, second.fingerprint)
+        assertEquals(64, first.fingerprint.length)
+        assertNull(first.authorityKey.encoded)
+        assertNull(first.serverKey.encoded)
+        assertArrayEquals(first.serverPublicKey.encoded, second.serverPublicKey.encoded)
+        assertEquals(listOf("identity.der"), directory.listFiles()!!.map { it.name })
+    }
+
+    @Test fun missingPublicIdentityStopsWithoutRegeneratingKeys() {
+        val first = store.open()
+        assertTrue(File(directory, "identity.der").delete())
+        rejected { store.open() }
+        assertFalse(File(directory, "identity.der").exists())
+        assertArrayEquals(first.authority.publicKey.encoded, keyStore.getCertificate("$prefix.authority").publicKey.encoded)
+    }
+
+    @Test fun corruptedPublicIdentityStopsWithoutOverwritingIt() {
+        store.open()
+        val file = File(directory, "identity.der")
+        val corrupt = byteArrayOf(1, 2, 3, 4)
+        file.writeBytes(corrupt)
+        rejected { store.open() }
+        assertArrayEquals(corrupt, file.readBytes())
+    }
+
+    @Test fun missingTlsKeyStopsWithoutRegeneratingIt() {
+        val first = store.open()
+        keyStore.deleteEntry("$prefix.server")
+        rejected { store.open() }
+        assertFalse(keyStore.containsAlias("$prefix.server"))
+        assertArrayEquals(first.authority.encoded, File(directory, "identity.der").readBytes())
+    }
+
+    @Test fun legacyIdentityRequiresExplicitMigration() {
+        legacy.writeBytes(byteArrayOf(9))
+        rejected { store.open() }
+        assertFalse(keyStore.containsAlias("$prefix.authority"))
+        assertFalse(File(directory, "identity.der").exists())
+        assertArrayEquals(byteArrayOf(9), legacy.readBytes())
+    }
+
+    @Test fun expiredStoredIdentityCannotBeReplacedSilently() {
+        val first = store.open()
+        val expired = DeviceCertificates.authority(first.authority.publicKey, first.authorityKey,
+            System.currentTimeMillis() - 3651L * 86_400_000)
+        File(directory, "identity.der").writeBytes(expired.encoded)
+        rejected { store.open() }
+        assertArrayEquals(expired.encoded, File(directory, "identity.der").readBytes())
+    }
+
+    /** Real TLS sockets, native Keystore signing, hostname verification, and application-byte accounting. */
+    private fun exchange(manager: AddressKeyManager, trusted: TlsIdentity): Pair<Boolean, Int> {
+        val serverContext = SSLContext.getInstance("TLS").apply { init(arrayOf(manager), null, SecureRandom()) }
+        val bytes = AtomicInteger()
+        val server = ModernServerSocketFactory(serverContext.serverSocketFactory)
+            .createServerSocket(0, 1, InetAddress.getByName("127.0.0.1")) as SSLServerSocket
+        assertTrue(server.enabledProtocols.all { it == "TLSv1.2" || it == "TLSv1.3" })
+        server.soTimeout = 5000
+        val worker = Thread {
+            try {
+                (server.accept() as SSLSocket).use { socket ->
+                    socket.soTimeout = 5000
+                    socket.startHandshake()
+                    if (socket.inputStream.read() == 42) {
+                        bytes.incrementAndGet()
+                        socket.outputStream.write(43)
+                    }
+                }
+            } catch (e: java.io.IOException) { android.util.Log.i("TlsIdentityTest", "Server handshake result", e) }
+        }.apply { start() }
+        var success = false
+        try {
+            val roots = KeyStore.getInstance(KeyStore.getDefaultType()).apply { load(null); setCertificateEntry("paired", trusted.authority) }
+            val trust = TrustManagerFactory.getInstance(TrustManagerFactory.getDefaultAlgorithm()).apply { init(roots) }
+            val client = SSLContext.getInstance("TLS").apply { init(null, trust.trustManagers, SecureRandom()) }
+            (client.socketFactory.createSocket("127.0.0.1", server.localPort) as SSLSocket).use { socket ->
+                socket.soTimeout = 5000
+                socket.sslParameters = socket.sslParameters.apply { endpointIdentificationAlgorithm = "HTTPS" }
+                socket.startHandshake()
+                socket.outputStream.write(42)
+                success = socket.inputStream.read() == 43
+            }
+        } catch (e: SSLException) { android.util.Log.i("TlsIdentityTest", "Client handshake result", e) }
+        finally { worker.join(6000); server.close() }
+        assertFalse("TLS worker must terminate", worker.isAlive)
+        return success to bytes.get()
+    }
+
+    @Test fun addressChangeRefreshesLeafAndRejectsOldAddressBeforeApplicationData() {
+        val identity = store.open()
+        var addresses = setOf(InetAddress.getByName("127.0.0.1"))
+        val manager = AddressKeyManager(identity) { addresses }
+        val original = manager.getCertificateChain("server")!!
+        assertEquals(true to 1, exchange(manager, identity))
+        addresses = setOf(InetAddress.getByName("127.0.0.2"))
+        assertEquals(false to 0, exchange(manager, identity))
+        val changed = manager.getCertificateChain("server")!!
+        assertFalse(original[0].encoded.contentEquals(changed[0].encoded))
+        assertArrayEquals(original[1].encoded, changed[1].encoded)
+        assertArrayEquals(original[0].publicKey.encoded, changed[0].publicKey.encoded)
+        addresses = setOf(InetAddress.getByName("127.0.0.1"), InetAddress.getByName("::1"))
+        assertEquals(true to 1, exchange(manager, identity))
+    }
+
+    @Test fun wrongPairedAuthorityRejectsHandshakeBeforeApplicationData() {
+        val identity = store.open()
+        val otherKey = java.security.KeyPairGenerator.getInstance("RSA").apply { initialize(2048) }.generateKeyPair()
+        val wrong = TlsIdentity(DeviceCertificates.authority(otherKey.public, otherKey.private),
+            otherKey.private, otherKey.public, otherKey.private)
+        assertEquals(false to 0, exchange(AddressKeyManager(identity) { setOf(InetAddress.getByName("127.0.0.1")) }, wrong))
+    }
+}
