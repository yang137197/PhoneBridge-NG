+package com.phonebridge.server
+
+// PhoneBridge NG, 2026-09-19. SPDX-License-Identifier: GPL-3.0-or-later
+import org.junit.Assert.*
+import org.junit.Test
+
+class XmlResponseBuilderTest {
+    @Test fun metacharactersAreEscapedAndHrefIsEncoded() {
+        val item = SharedEntry(SharedPath.parse("/<script>&\"' + %.txt"), false, 10, 0)
+        val xml = XmlResponseBuilder.buildPropfindResponse(listOf(item))
+        assertFalse(xml.contains("<script>"))
+        assertTrue(xml.contains("&lt;script&gt;&amp;&quot;&apos;"))
+        assertEquals("/%3Cscript%3E%26%22%27%20%2B%20%25.txt", XmlResponseBuilder.href(item))
+    }
+    @Test fun rootCollectionUsesOneSlash() {
+        assertEquals("/", XmlResponseBuilder.href(SharedEntry(SharedPath.parse("/"), true, 0, 0)))
+        assertEquals("/dir/", XmlResponseBuilder.href(SharedEntry(SharedPath.parse("/dir"), true, 0, 0)))
+    }
+}
