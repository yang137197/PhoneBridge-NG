+package com.phonebridge.server
+
+// PhoneBridge NG, 2026-09-19. SPDX-License-Identifier: GPL-3.0-or-later
+import org.junit.Assert.*
+import org.junit.Test
+
+class SharedPathTest {
+    private fun rejected(block: () -> Unit) {
+        try { block(); fail("Expected path rejection") } catch (_: StorageFailure) { }
+    }
+
+    @Test fun rootAndOrdinaryNames() {
+        assertTrue(SharedPath.parse("/").isRoot)
+        assertEquals(listOf("中文", "a + %25.txt"), SharedPath.parse("/中文/a + %25.txt").parts)
+        assertEquals("/child", SharedPath.parse("/child/").path)
+    }
+    @Test fun traversalRejectedInsteadOfRootFallback() {
+        listOf("/..", "/../Download-sibling/a", "/a/../../b", "/.", "/a/./b", "/a\\b", "relative",
+            "//", "/a//b", "/a\u0000b", "/a\r\nb", "/.phonebridge-upload-owned.part").forEach {
+            rejected { SharedPath.parse(it) }
+        }
+    }
+    @Test fun requestAlreadyDecodedExactlyOnce() {
+        assertEquals("%2e%2e", SharedPath.parse("/%2e%2e/file").parts.first())
+        assertEquals("plus+file", SharedPath.parse("/plus+file").name)
+    }
+    @Test fun destinationDecodedExactlyOnce() {
+        assertEquals("a+b %.txt", SharedPath.destination("https://host:8273/a+b%20%25.txt", "host:8273").name)
+        assertEquals("%2e%2e", SharedPath.destination("/%252e%252e", null).name)
+        rejected { SharedPath.destination("/%2e%2e/outside", null) }
+        rejected { SharedPath.destination("/a%5cb", null) }
+    }
+    @Test fun destinationAuthorityAndSyntaxValidated() {
+        listOf(null, "", "relative", "//host/path", "https://elsewhere/path", "https://user@host/path",
+            "https://host/path?q=1", "/path#fragment", "/invalid%", "file:///path", "mailto:a@host").forEach {
+            rejected { SharedPath.destination(it, "host") }
+        }
+        assertEquals("/ok", SharedPath.destination("https://HOST/ok", "host").path)
+    }
+    @Test fun rootMutationRejected() { rejected { SharedPath.parse("/").requireChild() } }
+}
