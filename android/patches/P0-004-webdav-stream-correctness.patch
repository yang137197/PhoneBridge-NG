index 0000000..18b8369
--- /dev/null
+++ b/android/app/src/test/java/com/phonebridge/server/RequestBodyTest.kt
@@ -0,0 +1,40 @@
+package com.phonebridge.server
+
+import java.io.ByteArrayInputStream
+import java.io.EOFException
+import java.io.InputStream
+import java.io.IOException
+import java.net.SocketTimeoutException
+import org.junit.Assert.*
+import org.junit.Test
+
+class RequestBodyTest {
+    private fun deadline() = System.nanoTime() + 5_000_000_000L
+    @Test fun leavesNextPipelinedRequestUntouched() {
+        val input = ByteArrayInputStream("bodyOPTIONS / HTTP/1.1\r\n".toByteArray())
+        RequestBody.discard(input, 4, deadline())
+        assertEquals("OPTIONS / HTTP/1.1\r\n", input.readBytes().toString(Charsets.UTF_8))
+    }
+    @Test fun zeroBodyDoesNotRead() {
+        val input = ByteArrayInputStream(byteArrayOf(7))
+        RequestBody.discard(input, 0, deadline())
+        assertEquals(7, input.read())
+    }
+    @Test(expected = EOFException::class) fun rejectsTruncatedBody() {
+        RequestBody.discard(ByteArrayInputStream(byteArrayOf(1)), 2, deadline())
+    }
+    @Test(expected = SocketTimeoutException::class) fun deadlineIsEnforced() {
+        RequestBody.discard(ByteArrayInputStream(byteArrayOf(1)), 1, System.nanoTime() - 1)
+    }
+    @Test(expected = IOException::class) fun noProgressCannotSpinForever() {
+        RequestBody.discard(object : InputStream() {
+            override fun read() = 0
+            override fun read(bytes: ByteArray, offset: Int, length: Int) = 0
+        }, 1, deadline())
+    }
+    @Test fun drainsMultipleBuffersExactly() {
+        val input = ByteArrayInputStream(ByteArray(20_001) { 5 })
+        RequestBody.discard(input, 20_000, deadline())
+        assertEquals(1, input.available())
+    }
+}
