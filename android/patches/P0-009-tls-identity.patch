@@ -0,0 +1,38 @@
+package com.phonebridge.server
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class HttpByteRangeTest {
+    @Test fun fullRepresentationWhenAbsentOrUnsupported() {
+        for (header in listOf(null, "items=0-1", "bytes=0-1,3-4")) {
+            assertEquals(HttpByteRange.Full, HttpByteRange.parse(header, 100))
+        }
+    }
+    @Test fun middleRangeAndClippedEnd() {
+        assertEquals(HttpByteRange.Partial(20, 29), HttpByteRange.parse("bytes=20-29", 100))
+        assertEquals(HttpByteRange.Partial(90, 99), HttpByteRange.parse("bytes=90-1000", 100))
+    }
+    @Test fun openRangeAndSuffix() {
+        assertEquals(HttpByteRange.Partial(30, 99), HttpByteRange.parse("bytes=30-", 100))
+        assertEquals(HttpByteRange.Partial(90, 99), HttpByteRange.parse("bytes=-10", 100))
+        assertEquals(HttpByteRange.Partial(0, 99), HttpByteRange.parse("bytes=-1000", 100))
+    }
+    @Test fun invalidAndUnsatisfiableRanges() {
+        for (header in listOf("bytes=100-", "bytes=20-19", "bytes=-0", "bytes=-", "bytes=x-3", "bytes=+1-3", "bytes=1- 3")) {
+            assertEquals(header, HttpByteRange.Unsatisfiable, HttpByteRange.parse(header, 100))
+        }
+        assertEquals(HttpByteRange.Unsatisfiable, HttpByteRange.parse("bytes=0-", 0))
+    }
+    @Test fun hugeDecimalOffsetsDoNotOverflow() {
+        val huge = "9".repeat(100)
+        assertEquals(HttpByteRange.Unsatisfiable, HttpByteRange.parse("bytes=$huge-", 100))
+        assertEquals(HttpByteRange.Partial(0, 99), HttpByteRange.parse("bytes=-$huge", 100))
+        assertEquals(HttpByteRange.Partial(90, 99), HttpByteRange.parse("bytes=90-$huge", 100))
+    }
+    @Test fun supportsFilesLargerThanIntMax() {
+        val range = HttpByteRange.parse("bytes=10000000000-19999999999", 20_000_000_000) as HttpByteRange.Partial
+        assertEquals(10_000_000_000, range.length)
+        assertEquals(HttpByteRange.Partial(99, 99), HttpByteRange.parse("BYTES=99-99", 100))
+    }
+}
