<Window x:Class="PhoneBridge.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:PhoneBridge.Desktop"
 Title="PhoneBridge NG" Icon="Assets/PhoneBridge.ico" Width="1200" Height="760" MinWidth="820" MinHeight="660"
 Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
 Loaded="OnLoaded" Closing="OnClosing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <Border Grid.Column="0" Background="#F8FAFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="20,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="4,0,0,32">
     <Image Width="32" Height="32" Source="Assets/PhoneBridge.png" Margin="0,0,10,0"/>
     <TextBlock Text="PhoneBridge NG" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource StrongTextBrush}" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <Button x:Name="DevicesNavigation" Style="{StaticResource NavButton}" Content="{local:Text NavDevices}" Click="NavigateDevicesClick" Background="{StaticResource SubtleBrush}" Foreground="{StaticResource PrimaryBrush}"/>
     <Button x:Name="SettingsNavigation" Style="{StaticResource NavButton}" Content="{local:Text NavSettings}" Click="NavigateSettingsClick"/>
     <Button x:Name="AboutNavigation" Style="{StaticResource NavButton}" Content="{local:Text NavAbout}" Click="NavigateAboutClick"/>
    </StackPanel>
    <TextBlock Grid.Row="3" Text="v0.2 UI acceptance" Style="{StaticResource MutedText}" Margin="4,0"/>
   </Grid>
  </Border>

  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <Grid Grid.Row="0">
    <Grid x:Name="DevicesPage" Margin="32">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="{local:Text MyPhones}" Style="{StaticResource PageTitle}"/>
       <TextBlock Text="{local:Text DevicesSubtitle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
       <Button Content="{local:Text Refresh}" Click="RefreshClick" Margin="0,0,12,0" AutomationProperties.AutomationId="Refresh"/>
       <Button Content="{local:Text AddPhone}" Style="{StaticResource PrimaryButton}" Click="AddPhoneClick" AutomationProperties.AutomationId="AddPhone"/>
      </StackPanel>
     </Grid>
     <ListBox x:Name="Devices" Grid.Row="1" Margin="-8,24,-8,0" Background="Transparent" BorderThickness="0"
      AutomationProperties.AutomationId="Devices" SelectionMode="Single" SelectionChanged="SelectionChanged"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Visibility" Value="{Binding ShowInDeviceList, Converter={StaticResource BooleanToVisibility}}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Border Style="{StaticResource Card}" Width="340" MinHeight="216" Margin="8">
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Ellipse Width="18" Height="18" Fill="{Binding Accent}" VerticalAlignment="Top" Margin="0,2,12,0"/>
           <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource CardTitle}"/>
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding State}" Foreground="{Binding Accent}" FontWeight="SemiBold" Margin="30,12,0,0"/>
          <StackPanel Grid.Row="2" Margin="30,10,0,18">
           <TextBlock Text="{Binding Mode}"/>
           <TextBlock Text="{Binding DriveSummary}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
          </StackPanel>
          <WrapPanel Grid.Row="3" Margin="30,0,0,0">
           <Button Content="{Binding PrimaryAction}" Style="{StaticResource PrimaryButton}" Click="DevicePrimaryClick" Margin="0,0,10,0"/>
           <Button Content="{local:Text Disconnect}" Click="DeviceDisconnectClick" Margin="0,0,10,0" Visibility="{Binding CanDisconnect, Converter={StaticResource BooleanToVisibility}}"/>
           <Button Content="{local:Text PhoneSettings}" Style="{StaticResource TextButton}" Click="DeviceSettingsClick"/>
          </WrapPanel>
         </Grid>
        </Border>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </Grid>

    <Grid x:Name="AddPhonePage" Visibility="Collapsed" Margin="32">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal">
      <Button Content="←" Style="{StaticResource TextButton}" Click="NavigateDevicesClick" Margin="0,0,8,0" AutomationProperties.Name="{local:Text Back}"/>
      <TextBlock Text="{local:Text AddPhone}" Style="{StaticResource PageTitle}"/>
     </StackPanel>
     <StackPanel Grid.Row="1" Margin="48,40" MaxWidth="720" HorizontalAlignment="Center">
      <TextBlock Text="{local:Text AddPhoneSteps}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,26"/>
      <Border Style="{StaticResource Card}" Padding="32">
       <StackPanel>
        <TextBlock x:Name="PairingPhoneName" Text="{local:Text ChoosePhoneFirst}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="{local:Text AddPhoneInstructions}" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,24"/>
        <TextBlock Text="{local:Text PairingCode}" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <PasswordBox x:Name="Code" AutomationProperties.Name="{local:Text PairingCode}" AutomationProperties.AutomationId="PairingCode" Width="300" MaxLength="8" FontFamily="Consolas" FontSize="24" HorizontalAlignment="Left" PasswordChanged="PairingCodeChanged"/>
        <TextBlock Text="{local:Text PairingCodeHint}" Style="{StaticResource MutedText}" Margin="0,8,0,24"/>
        <WrapPanel HorizontalAlignment="Right">
         <Button x:Name="Cancel" Content="{local:Text Cancel}" Click="CancelClick" AutomationProperties.AutomationId="Cancel" IsEnabled="False" Margin="0,0,10,0"/>
         <Button x:Name="Pair" Content="{local:Text PairAction}" Click="PairClick" AutomationProperties.AutomationId="Pair" Style="{StaticResource PrimaryButton}"/>
        </WrapPanel>
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>

    <ScrollViewer x:Name="DeviceSettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="32">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
       <Button Content="←" Style="{StaticResource TextButton}" Click="NavigateDevicesClick" Margin="0,0,8,0" AutomationProperties.Name="{local:Text Back}"/>
       <StackPanel><TextBlock Text="{local:Text PhoneSettings}" Style="{StaticResource PageTitle}"/><TextBlock x:Name="DeviceSettingsName" Style="{StaticResource MutedText}"/></StackPanel>
      </StackPanel>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="{local:Text ConnectionPreferences}" Style="{StaticResource SectionTitle}"/>
         <TextBlock Text="{local:Text Address}" FontWeight="SemiBold" Margin="0,20,0,8"/>
         <ComboBox x:Name="Endpoints" AutomationProperties.Name="{local:Text Address}" AutomationProperties.AutomationId="Endpoint" DisplayMemberPath="HttpsAddress"/>
         <TextBlock Text="{local:Text ConfirmedMode}" FontWeight="SemiBold" Margin="0,20,0,6"/>
         <TextBlock Text="{local:Text ModeManagedOnPhone}" Foreground="{StaticResource MutedTextBrush}"/>
         <Button x:Name="Unmount" Content="{local:Text Disconnect}" Click="UnmountClick" AutomationProperties.AutomationId="Unmount" Margin="0,24,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="{local:Text SafetyOperations}" Style="{StaticResource SectionTitle}"/>
         <TextBlock Text="{local:Text DeletePath}" FontWeight="SemiBold" Margin="0,20,0,8"/>
         <TextBox x:Name="DeletePath" AutomationProperties.Name="{local:Text DeletePath}" AutomationProperties.AutomationId="DeletePath" MaxLength="1024"/>
         <Button x:Name="DeleteConfirmed" Content="{local:Text AuthorizeDeletion}" Click="DeleteClick" AutomationProperties.AutomationId="DeleteConfirmed" Margin="0,12,0,0" HorizontalAlignment="Left"/>
        </StackPanel>
       </Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
       <StackPanel>
        <TextBlock Text="{local:Text RemoveAndAdvanced}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="{local:Text RemovePhoneHelp}" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,18"/>
        <Button x:Name="RemovePhone" Content="{local:Text RemovePhone}" Click="RemovePhoneClick" AutomationProperties.AutomationId="RemovePhone" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>

    <Grid x:Name="SettingsPage" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="#F8FAFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <StackPanel Margin="20,32">
       <Button x:Name="GeneralSettingsNavigation" Content="{local:Text General}" Style="{StaticResource NavButton}" Click="ShowGeneralSettingsClick" Background="{StaticResource SubtleBrush}" Foreground="{StaticResource PrimaryBrush}"/>
       <Button x:Name="AdvancedSettingsNavigation" Content="{local:Text AdvancedTroubleshooting}" Style="{StaticResource NavButton}" Click="ShowAdvancedSettingsClick"/>
      </StackPanel>
     </Border>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <Grid>
       <StackPanel x:Name="GeneralSettingsPage" Margin="32">
        <TextBlock Text="{local:Text General}" Style="{StaticResource PageTitle}" Margin="0,0,0,24"/>
        <TextBlock Text="{local:Text Language}" Style="{StaticResource SectionTitle}"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,24">
         <RadioButton Content="{local:Text SimplifiedChinese}" IsChecked="True" Margin="0,0,34,0"/>
         <RadioButton Content="English"/>
        </StackPanel>
        <Separator/>
        <TextBlock Text="{local:Text Startup}" Style="{StaticResource SectionTitle}" Margin="0,24,0,12"/>
        <CheckBox x:Name="AutoStart" Content="{local:Text AutoStart}" AutomationProperties.AutomationId="AutoStart" Checked="AutoStartChanged" Unchecked="AutoStartChanged"/>
        <TextBlock Text="{local:Text AutoStartHelp}" Style="{StaticResource MutedText}" Margin="24,8,0,24"/>
        <Separator/>
        <TextBlock Text="{local:Text DefaultDrive}" Style="{StaticResource SectionTitle}" Margin="0,24,0,10"/>
        <ComboBox x:Name="Drives" AutomationProperties.Name="{local:Text Drive}" AutomationProperties.AutomationId="Drive" Width="220" HorizontalAlignment="Left"/>
        <TextBlock Text="{local:Text AutomaticDriveHelp}" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
       </StackPanel>
       <StackPanel x:Name="AdvancedSettingsPage" Visibility="Collapsed" Margin="32">
        <TextBlock Text="{local:Text AdvancedTroubleshooting}" Style="{StaticResource PageTitle}" Margin="0,0,0,24"/>
        <Border Style="{StaticResource Card}">
         <StackPanel>
          <TextBlock Text="{local:Text TemporaryManualAddress}" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="{local:Text IdentityStillVerified}" Style="{StaticResource MutedText}" Margin="0,8,0,18"/>
          <WrapPanel>
           <TextBox x:Name="ManualAddress" AutomationProperties.Name="{local:Text ManualAddress}" AutomationProperties.AutomationId="ManualAddress" Width="240" MaxLength="80" Margin="0,0,10,0"/>
           <TextBox x:Name="ManualPort" AutomationProperties.Name="{local:Text ManualPort}" AutomationProperties.AutomationId="ManualPort" Width="90" MaxLength="5" Text="8273" Margin="0,0,10,0"/>
           <Button x:Name="UseManualAddress" Content="{local:Text UseManualAddress}" Click="ManualAddressClick" AutomationProperties.AutomationId="UseManualAddress" Margin="0,0,10,0"/>
           <Button x:Name="ClearManualAddress" Content="{local:Text ClearManualAddress}" Click="ClearManualAddressClick" AutomationProperties.AutomationId="ClearManualAddress"/>
          </WrapPanel>
         </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
         <StackPanel>
          <TextBlock Text="{local:Text Diagnostics}" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="{local:Text DiagnosticsNotUploaded}" Style="{StaticResource MutedText}" Margin="0,8,0,18"/>
          <Button x:Name="ExportBundle" Content="{local:Text ExportDiagnostics}" Click="ExportDiagnosticsClick" AutomationProperties.AutomationId="ExportDiagnostics" HorizontalAlignment="Left"/>
         </StackPanel>
        </Border>
       </StackPanel>
      </Grid>
     </ScrollViewer>
    </Grid>

    <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="48,42" MaxWidth="700" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
       <Image Width="64" Height="64" Source="Assets/PhoneBridge.png" Margin="0,0,20,0"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="PhoneBridge NG" Style="{StaticResource PageTitle}"/><TextBlock Text="{local:Text VersionPreview}" Style="{StaticResource MutedText}"/></StackPanel>
      </StackPanel>
      <Separator Margin="0,28"/>
      <TextBlock Text="{local:Text ProjectAndLicense}" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="{local:Text LicenseSummary}" Margin="0,12,0,8"/>
      <TextBlock><Hyperlink NavigateUri="https://github.com/yang137197/PhoneBridge-NG" RequestNavigate="OpenExternalLink"><Run Text="{local:Text GitHubProject}"/></Hyperlink></TextBlock>
      <TextBlock Text="{local:Text WinFspAttribution}" Style="{StaticResource MutedText}" Margin="0,18,0,0"/>
     </StackPanel>
    </ScrollViewer>

    <StackPanel Visibility="Collapsed">
     <Button x:Name="Connect" Content="{local:Text Connect}" Click="ConnectClick" AutomationProperties.AutomationId="Connect"/>
     <Button x:Name="Open" Content="{local:Text Open}" Click="OpenClick" AutomationProperties.AutomationId="Open"/>
    </StackPanel>
   </Grid>

   <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,11">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource ConnectionBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock x:Name="Status" AutomationProperties.AutomationId="Status" Text="{local:Text Ready}"/></StackPanel>
     <TextBlock x:Name="ConnectionStatus" Grid.Column="1" Foreground="{StaticResource MutedTextBrush}" Margin="20,0,0,0"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
