+package com.phonebridge
+
+// PhoneBridge NG, 2026-09-19. SPDX-License-Identifier: GPL-3.0-or-later
+import android.app.ActivityManager
+import android.app.NotificationManager
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.view.ViewGroup
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.test.core.app.ActivityScenario
+import androidx.test.platform.app.InstrumentationRegistry
+import com.phonebridge.service.PhoneBridgeService
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+
+class ServicePolicyTest {
+    private val instrumentation = InstrumentationRegistry.getInstrumentation()
+    private val context get() = instrumentation.targetContext
+    private val manager get() = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+    private fun service() = manager.getRunningServices(20).firstOrNull { it.service.className == PhoneBridgeService::class.java.name }
+    private fun awaitCondition(message: String, condition: () -> Boolean) {
+        val end = System.nanoTime() + 10_000_000_000L
+        while (System.nanoTime() < end) {
+            if (condition()) return
+            Thread.sleep(50)
+        }
+        assertTrue(message, condition())
+    }
+    @Before fun stopBefore() {
+        context.stopService(Intent(context, PhoneBridgeService::class.java))
+        awaitCondition("Previous service must stop") { service() == null }
+    }
+    @After fun stopAfter() { context.stopService(Intent(context, PhoneBridgeService::class.java)) }
+
+    @Test fun statusQueryDoesNotLeaveAStartedService() {
+        ActivityScenario.launch(MainActivity::class.java).use { scenario ->
+            instrumentation.waitForIdleSync()
+            Thread.sleep(300)
+            awaitCondition("A stopped status query must release its service") { service() == null }
+            if (Build.VERSION.SDK_INT >= 35) {
+                scenario.onActivity { activity ->
+                    val root = activity.findViewById<ViewGroup>(android.R.id.content).getChildAt(0)
+                    val insets = ViewCompat.getRootWindowInsets(root)!!
+                    val bars = insets.getInsets(WindowInsetsCompat.Type.systemBars() or WindowInsetsCompat.Type.displayCutout())
+                    assertTrue(root.paddingTop >= bars.top)
+                    assertTrue(root.paddingBottom >= bars.bottom)
+                }
+            }
+        }
+    }
+
+    @Test fun notificationStopActionStopsSharingService() {
+        ActivityScenario.launch(MainActivity::class.java).use { scenario ->
+            scenario.onActivity { activity ->
+                activity.startForegroundService(Intent(activity, PhoneBridgeService::class.java).setAction(PhoneBridgeService.ACTION_START))
+            }
+            awaitCondition("Sharing must really enter the foreground") { service()?.foreground == true }
+            val notifications = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+            awaitCondition("Foreground notification must exist") { notifications.activeNotifications.any { it.id == 1001 } }
+            val notification = notifications.activeNotifications.single { it.id == 1001 }.notification
+            notification.actions.single().actionIntent.send()
+            awaitCondition("Notification Stop must stop the service") { service() == null }
+            assertFalse(notifications.activeNotifications.any { it.id == 1001 })
+        }
+    }
+}
